<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly backup of recorder stream files. Rendered and loaded by scripts/install_daily_jobs.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.newsedge.novig-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>python</string>
        <string>scripts/backup_novig_stream.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <!-- 03:00 local. Stream days are UTC, so the previous UTC day is complete by then. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/novig-backup.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/novig-backup.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
