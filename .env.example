# paper or production. Keys work only in the environment that issued them.
NOVIG_ENV=paper
# A trading::read key from scripts/create_read_key.py, and its .pem path (outside the repo).
NOVIG_TRADING_KEY_ID=
NOVIG_PRIVATE_KEY_PATH=
APIFY_TOKEN=
JEV_API_KEY=
ODDS_API_KEY=
DATABASE_URL=

# Local Postgres (docker compose). Change the password if the port is ever exposed.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
